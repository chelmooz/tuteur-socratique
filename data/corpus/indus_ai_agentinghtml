            <text class="sub" x="106" y="260" text-anchor="middle">volume de production</text>
            <text class="sub" x="106" y="270" text-anchor="middle">grâce au parallélisme</text>
            <rect class="boxBad" x="204" y="216" width="164" height="58" rx="8"/>
            <text x="286" y="244" text-anchor="middle" style="font-family:var(--mono); font-size:22px; font-weight:700; fill:var(--bad)">~10 %</text>
            <text class="sub" x="286" y="260" text-anchor="middle">accélération du produit</text>
