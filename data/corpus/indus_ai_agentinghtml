<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Industrial Agentic Engineering — Masterclass interactive</title>
<meta name="description" content="Masterclass interactive premium sur la thèse « Industrial Agentic Engineering » (2026) de Ramón Medrano Llamas : harnais, perte de micro-contrôle, méta-débogage.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230b0f14'/%3E%3Cpath d='M8 22V10l8 6 8-6v12' stroke='%236ea8fe' stroke-width='2.4' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<style>
/* ============ TOKENS ============ */
:root{
  --step--1:clamp(.78rem,.76rem + .1vw,.85rem);
  --step-0:clamp(.98rem,.95rem + .16vw,1.06rem);
  --step-1:clamp(1.14rem,1.08rem + .3vw,1.32rem);
  --step-2:clamp(1.38rem,1.25rem + .6vw,1.75rem);
  --step-3:clamp(1.7rem,1.45rem + 1.1vw,2.4rem);
  --step-4:clamp(2.05rem,1.6rem + 2vw,3.4rem);
  --step-5:clamp(2.4rem,1.7rem + 3.2vw,4.6rem);
  --sp-1:.35rem; --sp-2:.65rem; --sp-3:1rem; --sp-4:1.5rem; --sp-5:2.25rem;
  --sp-6:3.25rem; --sp-7:4.75rem; --sp-8:7rem;
  --r-s:8px; --r-m:14px; --r-l:22px;
  --mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --serif:ui-serif,Georgia,"Iowan Old Style","Times New Roman",serif;
  --maxw:1140px;
  --ease:cubic-bezier(.22,.7,.28,1);
}
html[data-theme="dark"]{
  --bg:#080b10; --bg2:#0c1118; --surf:#111824; --surf2:#161f2e; --line:#202c3d;
  --line2:#2b3a4f; --tx:#e8eef7; --tx2:#a7b6ca; --tx3:#74869e;
  --ac:#6ea8fe; --ac-d:#2b6fd4; --ac2:#4fd1c5; --warn:#f3b95f; --bad:#f28b82; --good:#6fdba0;
  --glow:0 0 0 1px rgba(110,168,254,.22), 0 18px 50px -20px rgba(110,168,254,.28);
  --shadow:0 1px 2px rgba(0,0,0,.4),0 14px 40px -24px rgba(0,0,0,.9);
  --grid-c:rgba(255,255,255,.035);
}
html[data-theme="light"]{
  --bg:#f6f8fc; --bg2:#eef2f8; --surf:#ffffff; --surf2:#f4f7fb; --line:#dde5ef;
  --line2:#c6d2e2; --tx:#0d1520; --tx2:#4d5f75; --tx3:#75869c;
  --ac:#1f5fc4; --ac-d:#164a9e; --ac2:#0e8d82; --warn:#9a6413; --bad:#b3261e; --good:#1c7a4d;
  --glow:0 0 0 1px rgba(31,95,196,.18), 0 16px 44px -22px rgba(31,95,196,.24);
  --shadow:0 1px 2px rgba(16,32,56,.06),0 14px 36px -22px rgba(16,32,56,.28);
  --grid-c:rgba(13,21,32,.045);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth; -webkit-text-size-adjust:100%}
body{
  margin:0; background:var(--bg); color:var(--tx); font-family:var(--sans);
  font-size:var(--step-0); line-height:1.68; letter-spacing:-.005em;
  -webkit-font-smoothing:antialiased;
  transition:background .4s var(--ease), color .4s var(--ease);
}
body::before{
  content:""; position:fixed; inset:0; z-index:0; pointer-events:none;
  background-image:linear-gradient(var(--grid-c) 1px,transparent 1px),linear-gradient(90deg,var(--grid-c) 1px,transparent 1px);
  background-size:64px 64px; mask-image:radial-gradient(ellipse 120% 80% at 50% 0%,#000 30%,transparent 78%);
}
h1,h2,h3,h4{line-height:1.14; letter-spacing:-.025em; margin:0; font-weight:640}
h2{font-size:var(--step-3)} h3{font-size:var(--step-1)}
p{margin:0 0 var(--sp-3)}
a{color:var(--ac); text-decoration-thickness:1px; text-underline-offset:3px}
code,kbd{font-family:var(--mono); font-size:.88em}
:focus-visible{outline:2.5px solid var(--ac); outline-offset:3px; border-radius:4px}
::selection{background:var(--ac); color:#fff}
.wrap{max-width:var(--maxw); margin:0 auto; padding:0 var(--sp-4); position:relative; z-index:1}
.mono{font-family:var(--mono); font-size:var(--step--1); letter-spacing:.06em; text-transform:uppercase; color:var(--tx3)}

/* ============ HEADER ============ */
header.top{
  position:sticky; top:0; z-index:60; backdrop-filter:blur(16px) saturate(1.6);
  background:color-mix(in srgb,var(--bg) 82%,transparent); border-bottom:1px solid var(--line);
}
.top-in{max-width:var(--maxw); margin:0 auto; padding:.6rem var(--sp-4); display:flex; align-items:center; gap:var(--sp-3)}
.brand{display:flex; align-items:center; gap:.6rem; font-weight:650; letter-spacing:-.03em; font-size:var(--step-0)}
.brand svg{width:26px; height:26px; color:var(--ac); flex:none}
.brand small{display:block; font-weight:450; font-size:.66rem; letter-spacing:.1em; text-transform:uppercase; color:var(--tx3); line-height:1}
.top-sp{flex:1}
.btn{
  font:inherit; font-size:var(--step--1); font-weight:560; cursor:pointer;
  background:var(--surf); color:var(--tx); border:1px solid var(--line2);
  padding:.48rem .85rem; border-radius:999px; display:inline-flex; align-items:center; gap:.45rem;
  transition:all .22s var(--ease); white-space:nowrap;
}
.btn:hover{border-color:var(--ac); color:var(--ac); transform:translateY(-1px)}
.btn.pri{background:var(--ac); border-color:var(--ac); color:#04080f; font-weight:640}
html[data-theme="light"] .btn.pri{color:#fff}
.btn.pri:hover{background:var(--ac-d); border-color:var(--ac-d); color:#fff}
.btn.sm{padding:.32rem .68rem; font-size:.76rem}
.btn[disabled]{opacity:.42; cursor:not-allowed; transform:none}
.prog-rail{height:3px; background:var(--line); position:relative; overflow:hidden}
.prog-bar{height:100%; width:0; background:linear-gradient(90deg,var(--ac2),var(--ac)); transition:width .5s var(--ease)}

/* ============ NAV ============ */
nav.toc{
  position:fixed; left:0; top:0; bottom:0; width:min(88vw,330px); z-index:90;
  background:var(--surf); border-right:1px solid var(--line); padding:var(--sp-4);
  overflow-y:auto; transform:translateX(-102%); transition:transform .38s var(--ease);
  box-shadow:24px 0 60px -30px rgba(0,0,0,.7);
}
nav.toc[data-open="1"]{transform:none}
nav.toc ol{list-style:none; margin:var(--sp-3) 0 0; padding:0; counter-reset:t}
nav.toc a{
  display:flex; gap:.7rem; padding:.44rem .55rem; border-radius:var(--r-s); text-decoration:none;
  color:var(--tx2); font-size:var(--step--1); line-height:1.4; counter-increment:t; align-items:baseline;
}
nav.toc a::before{content:counter(t,decimal-leading-zero); font-family:var(--mono); font-size:.68rem; color:var(--tx3); flex:none}
nav.toc a:hover{background:var(--surf2); color:var(--tx)}
nav.toc a.done{color:var(--good)}
nav.toc a.cur{background:color-mix(in srgb,var(--ac) 14%,transparent); color:var(--ac); font-weight:600}
.scrim{position:fixed; inset:0; z-index:80; background:rgba(2,5,10,.6); backdrop-filter:blur(3px); opacity:0; pointer-events:none; transition:opacity .3s}
.scrim[data-open="1"]{opacity:1; pointer-events:auto}

/* ============ SECTIONS ============ */
section.mod{padding:var(--sp-7) 0; border-top:1px solid var(--line); scroll-margin-top:70px}
section.mod:first-of-type{border-top:0}
.mod[hidden]{display:none}
.eyebrow{display:flex; align-items:center; gap:.7rem; margin-bottom:var(--sp-3); flex-wrap:wrap}
.eyebrow .num{
  font-family:var(--mono); font-size:.72rem; font-weight:600; letter-spacing:.1em;
  color:var(--ac); border:1px solid color-mix(in srgb,var(--ac) 40%,transparent);
  padding:.2rem .5rem; border-radius:5px; background:color-mix(in srgb,var(--ac) 10%,transparent);
}
.tag{font-family:var(--mono); font-size:.66rem; letter-spacing:.09em; text-transform:uppercase; color:var(--tx3); border:1px solid var(--line2); padding:.2rem .48rem; border-radius:5px}
.tag.deep{color:var(--ac2); border-color:color-mix(in srgb,var(--ac2) 45%,transparent)}
.lede{font-size:var(--step-1); color:var(--tx2); max-width:62ch; line-height:1.6}
.grid2{display:grid; gap:var(--sp-4); grid-template-columns:1fr}
@media(min-width:880px){.grid2{grid-template-columns:1fr 1fr}.grid2.wide-left{grid-template-columns:1.15fr .85fr}}

/* ============ CARDS ============ */
.card{background:var(--surf); border:1px solid var(--line); border-radius:var(--r-l); padding:var(--sp-4); box-shadow:var(--shadow)}
.card h3{margin-bottom:var(--sp-2)}
.card.tint{background:linear-gradient(160deg,color-mix(in srgb,var(--ac) 9%,var(--surf)),var(--surf) 60%); border-color:color-mix(in srgb,var(--ac) 30%,var(--line))}
.obj{border-left:3px solid var(--ac2); padding:.1rem 0 .1rem var(--sp-3); margin:0 0 var(--sp-4); color:var(--tx2)}
.obj strong{color:var(--tx); display:block; font-family:var(--mono); font-size:.7rem; letter-spacing:.11em; text-transform:uppercase; color:var(--ac2); margin-bottom:.2rem}
.keyidea{
  font-family:var(--serif); font-size:var(--step-2); line-height:1.34; letter-spacing:-.015em;
  border-radius:var(--r-m); padding:var(--sp-4); margin:0 0 var(--sp-4);
  background:var(--surf2); border:1px solid var(--line); position:relative;
}
.keyidea::before{content:"Idée clé"; position:absolute; top:-.6rem; left:var(--sp-4); font-family:var(--mono); font-size:.64rem; letter-spacing:.14em; text-transform:uppercase; background:var(--bg); padding:0 .5rem; color:var(--ac)}
blockquote.q{
  margin:0 0 var(--sp-4); padding:var(--sp-3) var(--sp-4); border-left:3px solid var(--ac);
  background:var(--surf2); border-radius:0 var(--r-m) var(--r-m) 0; font-family:var(--serif);
  font-size:var(--step-1); line-height:1.5; color:var(--tx);
}
blockquote.q cite{display:block; margin-top:.6rem; font-family:var(--sans); font-size:var(--step--1); font-style:normal; color:var(--tx3)}
.duo{display:grid; gap:var(--sp-3); grid-template-columns:1fr}
@media(min-width:720px){.duo{grid-template-columns:1fr 1fr}}
.ex,.cex{border-radius:var(--r-m); padding:var(--sp-3); border:1px solid var(--line); background:var(--surf2)}
.ex{border-left:3px solid var(--good)} .cex{border-left:3px solid var(--bad)}
.ex h4,.cex h4{font-family:var(--mono); font-size:.68rem; letter-spacing:.12em; text-transform:uppercase; margin-bottom:.4rem}
.ex h4{color:var(--good)} .cex h4{color:var(--bad)}
.ex p,.cex p{margin:0; font-size:var(--step--1); color:var(--tx2); line-height:1.6}
ul.ticks{list-style:none; padding:0; margin:0 0 var(--sp-3)}
ul.ticks li{padding-left:1.5rem; position:relative; margin-bottom:.5rem; color:var(--tx2)}
ul.ticks li::before{content:"→"; position:absolute; left:0; color:var(--ac); font-family:var(--mono)}
ul.ticks li b,ul.ticks li strong{color:var(--tx)}
.takeaway{
  margin-top:var(--sp-4); padding:var(--sp-3) var(--sp-4); border-radius:var(--r-m);
  background:color-mix(in srgb,var(--ac2) 12%,var(--surf)); border:1px dashed color-mix(in srgb,var(--ac2) 45%,var(--line));
}
.takeaway .mono{color:var(--ac2); margin-bottom:.3rem; display:block}
.takeaway p{margin:0; color:var(--tx)}

/* ============ SOURCE GROUNDING ============ */
.src{
  display:inline-flex; align-items:center; gap:.3rem; vertical-align:baseline; cursor:pointer;
  font-family:var(--mono); font-size:.6rem; font-weight:600; letter-spacing:.06em;
  background:color-mix(in srgb,var(--ac2) 16%,transparent); color:var(--ac2);
  border:1px solid color-mix(in srgb,var(--ac2) 40%,transparent); border-radius:4px;
  padding:.08rem .3rem; margin-left:.25rem; transition:all .2s;
}
.src:hover{background:var(--ac2); color:#04080f}
html[data-theme="light"] .src:hover{color:#fff}
.srcbox{
  margin:var(--sp-2) 0 var(--sp-3); padding:var(--sp-3); border-radius:var(--r-m);
  background:var(--surf2); border:1px solid var(--line); border-left:3px solid var(--ac2);
  font-size:var(--step--1); line-height:1.6; color:var(--tx2);
}
.srcbox[hidden]{display:none}
.srcbox q{font-style:italic; color:var(--tx)}
.srcbox .ref{display:block; margin-top:.5rem; font-family:var(--mono); font-size:.68rem; color:var(--tx3); word-break:break-all}

/* ============ TABLES ============ */
.tbl-wrap{overflow-x:auto; border:1px solid var(--line); border-radius:var(--r-m); background:var(--surf)}
table{width:100%; border-collapse:collapse; font-size:var(--step--1); min-width:520px}
th,td{padding:.62rem .8rem; text-align:left; border-bottom:1px solid var(--line); vertical-align:top}
th{font-family:var(--mono); font-size:.66rem; letter-spacing:.1em; text-transform:uppercase; color:var(--tx3); background:var(--surf2); position:sticky; top:0}
tbody tr:last-child td{border-bottom:0}
tbody tr.hl{background:color-mix(in srgb,var(--ac) 10%,transparent)}
tbody tr[hidden]{display:none}
td.n{color:var(--bad)} td.e{color:var(--good)}

/* ============ SVG DIAGRAMS ============ */
figure.dia{margin:0 0 var(--sp-4); background:var(--surf2); border:1px solid var(--line); border-radius:var(--r-m); padding:var(--sp-3); overflow:hidden}
figure.dia svg{width:100%; height:auto; display:block; overflow:visible}
figure.dia figcaption{margin-top:var(--sp-2); font-size:var(--step--1); color:var(--tx3); line-height:1.55}
.dia text{font-family:var(--sans); fill:var(--tx)}
.dia .lbl{font-size:11px; font-weight:600}
.dia .sub{font-size:9.5px; fill:var(--tx3); font-family:var(--mono); letter-spacing:.04em}
.dia .box{fill:var(--surf); stroke:var(--line2); stroke-width:1.2}
.dia .boxA{fill:color-mix(in srgb,var(--ac) 14%,var(--surf)); stroke:var(--ac); stroke-width:1.4}
.dia .boxB{fill:color-mix(in srgb,var(--ac2) 14%,var(--surf)); stroke:var(--ac2); stroke-width:1.4}
.dia .boxBad{fill:color-mix(in srgb,var(--bad) 13%,var(--surf)); stroke:var(--bad); stroke-width:1.3}
.dia .arr{stroke:var(--line2); stroke-width:1.6; fill:none; marker-end:url(#ah)}
.dia .arrA{stroke:var(--ac); stroke-width:1.8; fill:none; marker-end:url(#ahA)}
.dia .dash{stroke-dasharray:5 5}
.flow{stroke-dasharray:7 9; animation:flowdash 1.5s linear infinite}
@keyframes flowdash{to{stroke-dashoffset:-32}}
.pulse{animation:pulse 2.6s var(--ease) infinite}
@keyframes pulse{0%,100%{opacity:.35; transform:scale(.96)}50%{opacity:1; transform:scale(1.03)}}
.spin{animation:spin 9s linear infinite; transform-origin:center}
@keyframes spin{to{transform:rotate(360deg)}}
.draw{stroke-dasharray:var(--len,300); stroke-dashoffset:var(--len,300); animation:draw 1.8s var(--ease) forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.reveal{opacity:0; transform:translateY(14px); transition:opacity .7s var(--ease),transform .7s var(--ease)}
.reveal.in{opacity:1; transform:none}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important}
  html{scroll-behavior:auto}
  .reveal{opacity:1; transform:none}
}

/* ============ QUIZ ============ */
.quiz{background:var(--surf); border:1px solid var(--line2); border-radius:var(--r-l); padding:var(--sp-4); margin-top:var(--sp-4)}
.quiz .qh{display:flex; align-items:center; gap:.55rem; margin-bottom:var(--sp-3)}
.quiz .qh .mono{color:var(--ac); margin:0}
.q-item{margin-bottom:var(--sp-4)}
.q-item:last-of-type{margin-bottom:0}
.q-item > p.qt{font-weight:600; margin-bottom:var(--sp-2); color:var(--tx)}
.opts{display:grid; gap:.5rem}
.opt{
  display:flex; gap:.7rem; align-items:flex-start; text-align:left; width:100%; cursor:pointer;
  background:var(--surf2); border:1px solid var(--line); border-radius:var(--r-m);
  padding:.66rem .85rem; font:inherit; font-size:var(--step--1); color:var(--tx2); line-height:1.55;
  transition:all .2s var(--ease);
}
.opt:hover:not([data-locked]){border-color:var(--ac); color:var(--tx); transform:translateX(3px)}
.opt .k{font-family:var(--mono); font-size:.72rem; font-weight:700; color:var(--tx3); flex:none; width:1.1em}
.opt[data-state="ok"]{border-color:var(--good); background:color-mix(in srgb,var(--good) 15%,var(--surf)); color:var(--tx)}
.opt[data-state="ok"] .k{color:var(--good)}
.opt[data-state="no"]{border-color:var(--bad); background:color-mix(in srgb,var(--bad) 13%,var(--surf)); color:var(--tx)}
.opt[data-state="no"] .k{color:var(--bad)}
.opt[data-locked]{cursor:default}
.fb{margin-top:.6rem; padding:.6rem .85rem; border-radius:var(--r-m); font-size:var(--step--1); line-height:1.6; border:1px solid var(--line)}
.fb[hidden]{display:none}
.fb.ok{background:color-mix(in srgb,var(--good) 12%,var(--surf)); border-color:color-mix(in srgb,var(--good) 40%,var(--line))}
.fb.no{background:color-mix(in srgb,var(--bad) 11%,var(--surf)); border-color:color-mix(in srgb,var(--bad) 38%,var(--line))}
.fb b{color:var(--tx)}

/* ============ FORMS ============ */
label.fl{display:block; font-family:var(--mono); font-size:.68rem; letter-spacing:.1em; text-transform:uppercase; color:var(--tx3); margin-bottom:.3rem}
input[type=text],select,textarea{
  width:100%; font:inherit; font-size:var(--step--1); color:var(--tx); background:var(--bg2);
  border:1px solid var(--line2); border-radius:var(--r-s); padding:.55rem .7rem;
}
textarea{font-family:var(--mono); line-height:1.6; resize:vertical}
.fr{margin-bottom:var(--sp-3)}
pre.out{
  font-family:var(--mono); font-size:.76rem; line-height:1.65; background:var(--bg2);
  border:1px solid var(--line2); border-radius:var(--r-m); padding:var(--sp-3);
  white-space:pre-wrap; word-break:break-word; max-height:440px; overflow:auto; margin:0; color:var(--tx2);
}
/* ============ CHECKLIST ============ */
ul.ck{list-style:none; padding:0; margin:0; display:grid; gap:.45rem}
ul.ck li label{
  display:flex; gap:.7rem; align-items:flex-start; cursor:pointer; padding:.6rem .8rem;
  background:var(--surf2); border:1px solid var(--line); border-radius:var(--r-m);
  font-size:var(--step--1); color:var(--tx2); line-height:1.55; transition:all .2s;
}
ul.ck li label:hover{border-color:var(--ac)}
ul.ck input{margin:.28rem 0 0; accent-color:var(--ac); width:1.05rem; height:1.05rem; flex:none}
ul.ck input:checked ~ span{color:var(--tx3); text-decoration:line-through}
ul.ck li label:has(input:checked){border-color:color-mix(in srgb,var(--good) 45%,var(--line)); background:color-mix(in srgb,var(--good) 9%,var(--surf))}
ul.ck span b{color:var(--tx)}
/* ============ FLASHCARDS ============ */
.fcstage{perspective:1400px; margin-bottom:var(--sp-3)}
.fc{
  position:relative; width:100%; min-height:250px; cursor:pointer;
  transform-style:preserve-3d; transition:transform .62s var(--ease);
}
.fc[data-flip="1"]{transform:rotateY(180deg)}
.fc > div{
  position:absolute; inset:0; backface-visibility:hidden; border-radius:var(--r-l);
  border:1px solid var(--line2); padding:var(--sp-4); display:flex; flex-direction:column;
  justify-content:center; gap:.7rem; box-shadow:var(--shadow);
}
.fc .front{background:linear-gradient(155deg,var(--surf2),var(--surf)); align-items:center; text-align:center}
.fc .front strong{font-family:var(--serif); font-size:var(--step-2); line-height:1.24}
.fc .back{background:var(--surf); transform:rotateY(180deg); font-size:var(--step--1); color:var(--tx2); overflow:auto}
.fc .back p{margin:0 0 .55rem}
.fc .back .tt{font-family:var(--mono); font-size:.64rem; letter-spacing:.11em; text-transform:uppercase; color:var(--ac); display:block; margin-bottom:.15rem}
.fcbar{display:flex; align-items:center; gap:.5rem; flex-wrap:wrap}
.fcbar .cnt{font-family:var(--mono); font-size:.74rem; color:var(--tx3); margin-left:auto}
/* ============ SCENARIO ============ */
.scn{background:var(--surf); border:1px solid var(--line2); border-radius:var(--r-l); padding:var(--sp-4)}
.scn .sit{font-family:var(--serif); font-size:var(--step-1); line-height:1.5; margin-bottom:var(--sp-3)}
.cons{margin-top:var(--sp-3); border-radius:var(--r-m); padding:var(--sp-3); border:1px solid var(--line); background:var(--surf2)}
.cons[hidden]{display:none}
.cons h4{font-size:var(--step-0); margin-bottom:.4rem}
.cons .verd{font-family:var(--mono); font-size:.68rem; letter-spacing:.11em; text-transform:uppercase; display:inline-block; padding:.18rem .5rem; border-radius:5px; margin-bottom:.6rem}
