            <path class="arrA" d="M204 141 H228"/>
            <rect class="boxB" x="232" y="124" width="112" height="34" rx="7"/><text class="lbl" x="288" y="141" text-anchor="middle">Implémenter</text><text class="sub" x="288" y="154" text-anchor="middle">abondant</text>
            <path class="arrA" d="M348 141 H366"/><rect class="box" x="352" y="124" width="38" height="34" rx="7" opacity="0"/>
            <text class="sub" x="374" y="145">livrer</text>

            <rect class="box" x="10" y="184" width="380" height="104" rx="10" style="stroke-dasharray:4 4"/>
            <text class="lbl" x="24" y="206">Deux chiffres à retenir</text>
