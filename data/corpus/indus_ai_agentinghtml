    <div class="card" style="margin-top:var(--sp-4)" id="diagCard">
      <div class="grid2">
        <div>
          <div class="fr"><label class="fl" for="dq1">1 · Votre rôle principal</label>
            <select id="dq1"><option value="">—</option><option value="sre">SRE / Ops / Plateforme</option><option value="dev">Développeur / Tech lead</option><option value="mgr">Manager engineering / CTO</option><option value="autre">Autre (produit, data, sécurité)</option></select></div>
