 {q:'Pourquoi le journal de bord de l’agent (write_todos) est-il déterminant ?',
  o:['Pour produire un rapport d’activité destiné au management','Parce qu’il rend la trajectoire analysable, condition nécessaire du méta-débogage','Pour réduire la consommation de tokens','Pour permettre à l’agent de reprendre après interruption uniquement'],a:1,
  e:'Sans trajectoire consignée, l’échec reste opaque : on ne peut plus identifier le levier de harnais à corriger.'},
 {q:'Quelle « vérité désagréable » le deck énonce sur le rôle de l’ingénieur ?',
  o:['Le métier disparaît à court terme','Piloter plusieurs agents en parallèle est épuisant : vous êtes le pilote, pas le passager','L’ingénieur devient purement gestionnaire de coûts','La charge cognitive diminue nettement'],a:1,
  e:'« Managing 6 parallel agents is exhausting. You are the pilot, not the passenger. » Le métier ne disparaît pas ; il évolue vers l’architecture système.'}
];
(function(){
  var idx=0,ans=[],t0=0,timer=null,DUR=600;
  function fmt(s){var m=Math.floor(s/60),x=s%60;return m+':'+(x<10?'0':'')+x;}
  function tick(){
    var left=DUR-Math.floor((Date.now()-t0)/1000);
    if(left<=0){left=0;finish(true);}
    $('#exTimer').textContent=fmt(left);
    $('#exTimer').classList.toggle('warn',left<=180&&left>60);$('#exTimer').classList.toggle('crit',left<=60);
  }
  function renderQ(){
    $('#exCnt').textContent=idx+' / '+EXAM.length;
    $('#exBar').style.width=Math.round(idx/EXAM.length*100)+'%';
    if(idx>=EXAM.length){finish(false);return;}
    var q=EXAM[idx];
    var h='<span class="mono">Question '+(idx+1)+' sur '+EXAM.length+'</span><p class="qt">'+q.q+'</p><div class="opts">';
    q.o.forEach(function(o,k){h+='<button class="opt" data-k="'+k+'"><span class="k">'+'ABCD'[k]+'</span><span>'+o+'</span></button>';});
    h+='</div>';
    $('#exBody').innerHTML=h;
    $$('#exBody .opt').forEach(function(b){b.addEventListener('click',function(){
      ans[idx]=parseInt(b.getAttribute('data-k'),10); idx++; renderQ();
    });});
  }
  function finish(timeout){
    clearInterval(timer); timer=null;
    $('#exFinish').hidden=true; $('#exStart').hidden=false; $('#exStart').textContent='Refaire l’examen';
    var ok=0,rows='';
    EXAM.forEach(function(q,i){
      var good=ans[i]===q.a; if(good)ok++;
      rows+='<div class="q-item" data-locked="1"><p class="qt">'+(i+1)+'. '+q.q+'</p>'
        +'<div class="fb '+(good?'ok':'no')+'"><b>'+(good?'Correct. ':'Incorrect. ')+'</b>'
        +(good?'':'Bonne réponse : <b>'+q.o[q.a]+'</b>'+(ans[i]===undefined?' (non répondue)':'')+'. ')
        +q.e+'</div></div>';
    });
    var pct=Math.round(ok/EXAM.length*100), pass=pct>=75;
    S.exam={score:ok,total:EXAM.length,pct:pct,pass:pass,at:new Date().toISOString()};
    if(pass)S.done.m15=true; save();
    $('#exBody').innerHTML='<p style="margin:0; color:var(--tx3)">Examen terminé'+(timeout?' — temps écoulé':'')+'. Correction détaillée ci-dessous.</p>';
    var res=$('#exRes'); res.hidden=false;
    res.innerHTML='<div class="'+(pass?'takeaway':'warnbox')+'"><span class="mono">Résultat</span>'
      +'<p style="font-size:var(--step-2); font-family:var(--mono); color:'+(pass?'var(--ac)':'var(--bad)')+'; margin:.2rem 0">'+ok+' / '+EXAM.length+' — '+pct+' %</p>'
      +'<p>'+(pass?'Seuil de réussite atteint (75 %). Le certificat est débloqué en fin de parcours.':'Seuil non atteint (75 % requis). Revoyez les modules signalés ci-dessous, puis refaites l’examen — les questions restent les mêmes, l’objectif est la maîtrise, pas la surprise.')+'</p></div>'
      +'<div class="quiz" style="margin-top:var(--sp-4)">'+rows+'</div>';
    renderDash(); renderCert(); refreshProgress();
    toast(pass?'Examen réussi — '+pct+' %':'Examen : '+pct+' %, seuil 75 %');
  }
  $('#exStart').addEventListener('click',function(){
    idx=0;ans=[];t0=Date.now();
    $('#exStart').hidden=true;$('#exFinish').hidden=false;$('#exRes').hidden=true;
    clearInterval(timer);timer=setInterval(tick,250);tick();renderQ();
  });
  $('#exFinish').addEventListener('click',function(){finish(false);});
})();

/* ---------- CHECKLIST 7 JOURS ---------- */
var CK=[
 ['j1','<b>Jour 1 — Rendre le critère d’acceptation exécutable.</b> Choisissez un module. Rendez les avertissements de linter bloquants, ajoutez un test de propriété sur la logique centrale. Objectif : une commande unique qui dit vrai.'],
 ['j2','<b>Jour 2 — Écrire le socle de contexte.</b> Un fichier <code>AGENTS.md</code> ou <code>GEMINI.md</code> : architecture, style, chemins clés, invariants, commande de vérification. Écrit pour l’agent, pas pour un humain.'],
 ['j3','<b>Jour 3 — Construire le registre d’outils.</b> Exposez trois à cinq commandes CLI, avec description explicite et aide accessible. Annotez chacune : sûre, réversible, destructive.'],
 ['j4','<b>Jour 4 — Poser la passerelle de sécurité.</b> Bac à sable, identité restreinte, simulation à blanc obligatoire, bouton d’arrêt testé. Démarrez à L2 : l’agent propose, vous approuvez.'],
 ['j5','<b>Jour 5 — Déléguer une première tâche de boilerplate.</b> Périmètre net, critère mécanique, une seule tâche. Ne corrigez rien du style. Notez uniquement ce qui viole une contrainte vérifiable.'],
 ['j6','<b>Jour 6 — Exécuter un cycle de méta-débogage.</b> Prenez le défaut le plus reproductible observé la veille. Triez le levier, corrigez le harnais, ajoutez le cas au jeu d’évaluation, mesurez sur dix exécutions.'],
 ['j7','<b>Jour 7 — Passer à deux tâches concurrentes.</b> Seulement maintenant. Mesurez votre temps autonome moyen avant intervention : c’est l’indicateur de qualité de votre harnais.']
];
(function(){
  var ul=$('#ckList');
  CK.forEach(function(c){
    var li=document.createElement('li');
    var id='ck_'+c[0];
    li.innerHTML='<label for="'+id+'"><input type="checkbox" id="'+id+'"><span>'+c[1]+'</span></label>';
    ul.appendChild(li);
    var cb=$('#'+id,li);
    cb.checked=!!S.ck[c[0]];
    li.classList.toggle('on',cb.checked);
    cb.addEventListener('change',function(){
      S.ck[c[0]]=cb.checked; li.classList.toggle('on',cb.checked);
      var n=0;for(var k in S.ck)if(S.ck[k])n++;
      if(n===CK.length){S.done.m16=true;toast('Plan d’action complété');}
      save();renderDash();renderCert();refreshProgress();
    });
  });
})();

/* ---------- TABLEAU DE BORD ---------- */
function renderDash(){
  var v=visibleMods(), doneN=0; v.forEach(function(m){if(S.done[m.id])doneN++;});
  var qn=0,qt=0;
  for(var k in S.quiz){for(var j in S.quiz[k]){qt++;if(S.quiz[k][j])qn++;}}
  var ckN=0;for(var c in S.ck)if(S.ck[c])ckN++;
  var fcN=0;for(var f in (S.fc||{}))if(S.fc[f])fcN++;
  var mins=Math.max(1,Math.round((Date.now()-(S.started||Date.now()))/60000));
  var kp=$('#kpis'); if(!kp)return;
  kp.innerHTML=[
   ['Modules validés',doneN+'/'+v.length],
   ['Réponses correctes',qt?Math.round(qn/qt*100)+' %':'—'],
   ['Examen final'+(S.exam?(S.exam.pass?' · réussi':' · à refaire'):''),S.exam?S.exam.pct+' %':'—'],
   ['Flashcards sues',fcN+'/'+FC.length],
   ['Plan d’action, jours',ckN+'/'+CK.length],
   ['Minutes sur le cours','~'+mins]
  ].map(function(x){return '<div class="kpi"><b>'+x[1]+'</b><div class="l">'+x[0]+'</div></div>';}).join('');
  var bars=$('#bars'); if(!bars)return;
  var qzs=$$('.quiz[data-quiz]');
  bars.innerHTML=qzs.map(function(qz){
    var id=qz.getAttribute('data-quiz');
    var sec=document.getElementById(id);
    var title=sec?sec.getAttribute('data-title'):id;
    var sc=quizScore(id), tot=$$('.q-item',qz).length;
    var pct=sc?Math.round(sc.ok/tot*100):0;
    return '<div class="barrow"><span style="color:var(--tx2)">'+title+'</span>'
      +'<span class="bartrack"><span class="barfill" style="width:'+pct+'%"></span></span>'
      +'<span class="mono" style="margin:0; color:var(--tx3)">'+(sc?sc.ok+'/'+tot:'—')+'</span></div>';
  }).join('');
}

/* ---------- CERTIFICAT ---------- */
function renderCert(){
  var w=$('#certWrap'); if(!w)return;
  var v=visibleMods(), doneN=0; v.forEach(function(m){if(S.done[m.id])doneN++;});
  var ready=S.exam&&S.exam.pass;
  if(!ready){
    w.innerHTML='<div class="card"><span class="mono">Certificat</span><p style="margin:.3rem 0 0; color:var(--tx2)">Le certificat se débloque après réussite de l’examen final au seuil de 75 %. '
      +(S.exam?'Dernier résultat : '+S.exam.pct+' %.':'Examen non encore passé.')
      +'</p><p style="margin-top:var(--sp-3)"><a class="btn" href="#m15">Aller à l’examen</a></p></div>';
    return;
  }
  var d=new Date(S.exam.at);
  var ref='IAE-'+d.getFullYear()+String(d.getMonth()+1).padStart(2,'0')+String(d.getDate()).padStart(2,'0')+'-'+String(S.exam.pct)+'-'+String(doneN);
  w.innerHTML='<div class="cert"><div class="badge">✓</div>'
   +'<span class="mono">Attestation de parcours</span>'
   +'<h3 style="font-size:var(--step-2); margin:.4rem 0 0">Industrial Agentic Engineering</h3>'
   +'<div class="score" style="margin-top:var(--sp-3)">'+S.exam.pct+' %</div>'
   +'<p style="color:var(--tx2); max-width:52ch; margin:.6rem auto 0">Score d’examen final au-dessus du seuil de réussite de 75 %, et '+doneN+' module'+(doneN>1?'s':'')+' validé'+(doneN>1?'s':'')+' sur '+v.length+'.</p>'
   +'<div class="meta"><span>Réf. '+ref+'</span><span>'+d.toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric'})+'</span><span>18 modules · 1 examen</span></div>'
   +'<p style="font-size:.74rem; color:var(--tx3); margin-top:var(--sp-3); max-width:60ch; margin-left:auto; margin-right:auto">Attestation auto-générée et stockée localement dans ce navigateur. Elle atteste d’un parcours d’auto-formation, non d’une certification délivrée par Google ou par l’auteur de la thèse.</p>'
   +'<p style="margin-top:var(--sp-4)"><button class="btn pri" id="expBtn2">Exporter ma progression (JSON)</button> <button class="btn" id="printBtn">Imprimer / PDF</button></p></div>';
  $('#expBtn2').addEventListener('click',exportJSON);
  $('#printBtn').addEventListener('click',function(){window.print();});
}
function exportJSON(){
  var v=visibleMods();
  var payload={
    cours:'Industrial Agentic Engineering — masterclass interactive',
    source:'Ramón Medrano Llamas, Google Research / T3chFest, 2026',
    exporte_le:new Date().toISOString(),
    mode:S.mode,
    modules_valides:Object.keys(S.done),
    modules_visibles:v.length,
    quiz:S.quiz,
    examen:S.exam,
    flashcards_sues:Object.keys(S.fc||{}).length,
    plan_action:S.ck
  };
  var b=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});
  var u=URL.createObjectURL(b),a=document.createElement('a');
  a.href=u;a.download='progression-industrial-agentic-engineering.json';a.click();URL.revokeObjectURL(u);
  toast('Progression exportée');
}

/* ---------- RÉINITIALISATION ---------- */
$('#resetBtn').addEventListener('click',function(){
  if(!window.confirm('Réinitialiser toute votre progression : réponses, examen, flashcards, plan d’action ? Cette action est définitive.'))return;
  clearRaw();
  location.reload();
});

/* ---------- RÉVÉLATION AU DÉFILEMENT + MODULE COURANT ---------- */
if('IntersectionObserver' in window){
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  $$('.reveal').forEach(function(el){io.observe(el);});
  var seen=new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(e.isIntersecting){
        var id=e.target.id;
        S.visits[id]=(S.visits[id]||0)+1;
        $$('#tocList a').forEach(function(a){a.classList.toggle('cur',a.getAttribute('data-for')===id);});
      }
    });
  },{rootMargin:'-45% 0px -45% 0px'});
  mods.forEach(function(m){seen.observe(m);});
}else{$$('.reveal').forEach(function(el){el.classList.add('in');});}

window.addEventListener('beforeunload',save);

/* ---------- DÉMARRAGE ---------- */
applyMode(); renderDash(); renderCert(); refreshProgress();
})();
