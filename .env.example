# Ollama Configuration (REQUIRED - 100% Local AI)
# Ollama must be running on localhost:11434 with models pulled
OLLAMA_HOST=http://localhost:11434

# Model assignments per mode
OLLAMA_MODEL_TUTEUR=prof-ia:latest
OLLAMA_MODEL_EXPERT=qwen2.5:7b
OLLAMA_MODEL_EMBEDDING=bge-m3:latest

# Opencode Fallback (optional - when Ollama is down)
OPENCODE_FALLBACK_ENABLED=false
OPENCODE_PATH=opencode
OPENCODE_TIMEOUT=120000

# Server Configuration
PORT=3001

# Legacy Gemini (REMOVED - no longer used)
# GEMINI_API_KEY=
# APP_URL=